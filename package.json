{
  "name": "iota-game-store",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler pages dev dist",
    "build": "node scripts/build-pages.js",
    "deploy": "npm run build && npm run deploy:pages",
    "deploy:pages": "wrangler pages deploy dist --project-name iota-xyz",
    "admin:local": "node scripts/local-admin.js",
    "db:create": "wrangler d1 create iota-games",
    "db:migrate:local": "wrangler d1 migrations apply iota-games --local",
    "db:migrate:remote": "wrangler d1 migrations apply iota-games --remote",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
