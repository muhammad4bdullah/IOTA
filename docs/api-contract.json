{
  "auth": {
    "login_endpoint": "/api/admin/login",
    "login_method": "POST",
    "login_body_shape": {
      "password": "string"
    },
    "cookie_name": "iota_admin",
    "cookie_flags": "Path=/api; HttpOnly; Secure; SameSite=Strict; Max-Age=43200",
    "session_ttl_seconds": 43200,
    "refresh_or_extend_endpoint": "not implemented",
    "logout_endpoint": "/api/admin/logout",
    "csrf_required": true,
    "csrf_header": "",
    "csrf_token_source": ""
  },
  "games": {
    "list_endpoint": "/api/admin/games",
    "list_method": "GET",
    "pagination_params": {
      "page": "",
      "limit": ""
    },
    "list_response_shape": {
      "games": [
        {
          "id": "string",
          "slug": "string",
          "title": "string",
          "developer": "string",
          "description": "string",
          "genre": ["string"],
          "platforms": ["string"],
          "version": "string",
          "releaseDate": "YYYY-MM-DD",
          "fileSizeLabel": "External host | Not uploaded",
          "coverImage": "string (HTTPS URL)",
          "price": 0,
          "rating": 0,
          "featured": false,
          "published": true,
          "hasFile": true,
          "sha256": "string",
          "downloadCount": 0,
          "rightsConfirmed": true,
          "license": "string",
          "fileUrl": "string (HTTPS URL)"
        }
      ],
      "totalDownloads": 0
    },
    "create_endpoint": "/api/admin/games",
    "create_method": "POST",
    "create_body_example": {
      "id": "cool-game",
      "title": "My Game",
      "developer": "Studio",
      "description": "A free game.",
      "genre": ["Action"],
      "platforms": ["Windows"],
      "version": "1.0",
      "releaseDate": "2025-01-01",
      "price": 0,
      "published": true,
      "rightsConfirmed": true,
      "license": "Owned",
      "coverImage": "https://example.com/cover.png",
      "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "fileUrl": "https://fileditch.com/file.zip"
    },
    "update_endpoint": "not implemented",
    "update_method": "",
    "update_is_partial": false,
    "delete_endpoint": "/api/admin/games/:id",
    "delete_method": "DELETE",
    "required_fields": [
      "id",
      "title",
      "developer",
      "description",
      "genre",
      "platforms",
      "version",

      "price",
      "published",
      "rightsConfirmed"
    ],
    "unique_fields": ["slug"],
    "server_generated_fields": [
      "slug",
      "downloadCount",
      "rating",
      "featured",
      "created_at",
      "updated_at"
    ]
  },
  "schema": {
    "id": {
      "type": "string",
      "required": true,
      "max_length": 80,
      "allowed_values": [],
      "notes": "Pattern ^[a-z0-9]+(?:-[a-z0-9]+)*$ (lowercase letters, digits, hyphens)."
    },
    "title": {
      "type": "string",
      "required": true,
      "max_length": 80,
      "allowed_values": [],
      "notes": "Trimmed length must be > 0 and <= 80."
    },
    "developer": {
      "type": "string",
      "required": true,
      "max_length": 80,
      "allowed_values": [],
      "notes": "Trimmed length must be > 0 and <= 80."
    },
    "description": {
      "type": "string",
      "required": true,
      "max_length": 400,
      "allowed_values": [],
      "notes": "Trimmed length must be > 0 and <= 400."
    },
    "genre": {
      "type": "array of strings",
      "required": true,
      "max_length": 12,
      "allowed_values": [],
      "notes": "1-12 items; each item trimmed length 1-32."
    },
    "platforms": {
      "type": "array of strings",
      "required": true,
      "max_length": 12,
      "allowed_values": [],
      "notes": "1-12 items; each item trimmed length 1-32."
    },
    "version": {
      "type": "string",
      "required": true,
      "max_length": 40,
      "allowed_values": [],
      "notes": "Trimmed length must be > 0 and <= 40."
    },
    "releaseDate": {
      "type": "string",
      "required": false,
      "max_length": 10,
      "allowed_values": [],
      "notes": "Optional; if provided must match YYYY-MM-DD, otherwise it defaults to \"\"."
    },
    "price": {
      "type": "number",
      "required": true,
      "max_length": 0,
      "allowed_values": [0],
      "notes": "Must equal 0; storefront is free-only."
    },
    "published": {
      "type": "boolean",
      "required": true,
      "max_length": 0,
      "allowed_values": [],
      "notes": "Must be a boolean."
    },
    "rightsConfirmed": {
      "type": "boolean",
      "required": true,
      "max_length": 0,
      "allowed_values": [true],
      "notes": "Must be true; publishing requires confirmed rights."
    },
    "license": {
      "type": "string",
      "required": false,
      "max_length": 500,
      "allowed_values": [],
      "notes": "Optional; defaults to \"\"; trimmed length <= 500."
    },
    "coverImage": {
      "type": "string",
      "required": false,
      "max_length": 0,
      "allowed_values": [],
      "notes": "Optional; must be an absolute HTTPS URL."
    },
    "sha256": {
      "type": "string",
      "required": false,
      "max_length": 64,
      "allowed_values": [],
      "notes": "Optional; must match ^[a-f0-9]{64}$ (64 hex chars)."
    },
    "fileUrl": {
      "type": "string",
      "required": false,
      "max_length": 2048,
      "allowed_values": [],
      "notes": "Optional; must be HTTPS on a fileditch.com host (fileditch.com, *.fileditch.com, fileditchhot.st, itsfileditchfiles.st, fileditchfiles.st, fileditchvids.st); no userinfo or port."
    }
  },
  "artwork": {
    "upload_endpoint": "/api/admin/upload",
    "upload_method": "POST",
    "content_type": "raw body (streamed)",
    "field_name": "",
    "max_bytes": 209715200,
    "accepted_formats": [
      ".zip",
      ".7z",
      ".rar",
      ".tar",
      ".gz",
      ".tgz",
      ".exe",
      ".msi",
      ".dmg",
      ".appimage",
      ".deb",
      ".rpm",
      ".pdf",
      ".txt"
    ],
    "returns": "201 JSON: {\"url\":\"/api/files/<key>\",\"key\":\"...\",\"filename\":\"...\",\"size\":0,\"sha256\":\"...\",\"contentType\":\"...\"}. Filename comes from the x-file-name header (optional x-sha256 header). Extensions .html/.htm/.js/.mjs/.css/.svg/.xml/.json are rejected; no extension is allowed. Over 200 MB -> 413."
  },
  "downloads": {
    "shape": {
      "fileUrl": "string (HTTPS download-host URL; admin view only)",
      "hasFile": "boolean (file_url and rights_confirmed)",
      "fileSizeLabel": "External host | Not uploaded",
      "downloadCount": "number"
    },
    "separate_endpoint": "/api/games/:id/download",
    "method": "GET"
  },
  "errors": {
    "validation_status": 400,
    "validation_body_example": {
      "error": "Title, developer, or description is invalid."
    },
    "duplicate_status": 0,
    "duplicate_body_example": {},
    "rate_limit_status": 429,
    "rate_limit_headers": []
  },
  "limits": {
    "max_body_bytes": 32000,
    "max_batch_size": 0,
    "concurrent_requests_safe": 0
  },
  "misc": {
    "base_path_prefix": "/api",
    "trailing_slash_required": false,
    "case_sensitive_ids": true,
    "id_format": "^[a-z0-9]+(?:-[a-z0-9]+)*$ (max 80 chars)",
    "notes": "All non-GET API requests enforce an Origin header that must match the request's own origin (CSRF protection via origin check, not a token). Login returns {\"authenticated\":true} and sets the iota_admin cookie; logout returns {\"authenticated\":false} and clears it; GET /api/admin/session returns {\"authenticated\":bool} without extending the session. Admin routes require the session cookie on the /api path. POST /api/admin/games is an UPSERT: an existing id is overwritten (ON CONFLICT(id) DO UPDATE), so there is no 409 duplicate response; create and update share the same body. slug is server-set equal to id. JSON create bodies are capped at 32 KB; the login body is capped at 4 KB. Login is rate-limited to 10 failures per 15 minutes per client IP (429). Unauthorized -> 401 {\"error\":\"Sign in as the site administrator to continue.\"}; unknown routes -> 404; upload over size -> 413."
  }
}
